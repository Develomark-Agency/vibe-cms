{
  // The CLI, the Vite plugin and backups run in Bun or Node, so they're checked again without the DOM lib:
  // a browser-only API there is a bug.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ESNext"],
    "types": ["bun"]
  },
  "include": ["src/cli", "src/vite", "src/backups", "scripts", "src/css.d.ts"]
}
