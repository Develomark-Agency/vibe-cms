{
  // The CLI, the Vite plugin and backups run in Node (or Bun), so they're checked again with only Node's
  // types: a browser- or Bun-only API there is a bug.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ESNext"],
    "types": ["node"]
  },
  "include": ["src/cli", "src/vite", "src/backups", "src/css.d.ts"]
}
