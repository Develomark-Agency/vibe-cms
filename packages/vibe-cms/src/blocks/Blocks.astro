---
/*
 * A page's blocks, in order. `components` maps block types to Astro
 * components, or React, Vue and Svelte ones (rendered on the server). For a
 * hydrated island, map the type to a small Astro wrapper that renders your
 * framework component with a `client:` directive; Astro needs directives
 * written in a file, not on components picked at runtime.
 */
import type { AnyBlock } from "./define.ts";
import type { AstroComponents } from "./astro.ts";
import type { RenderContext } from "./html.ts";
import { inPickRender, inPreview, pickSource, pickVariants, renderBlock } from "vibe-cms/blocks/astro-runtime";
import Variant from "./Variant.astro";

interface Props<B extends AnyBlock = AnyBlock> extends RenderContext {
  blocks: readonly B[] | null | undefined,
  components: AstroComponents<B>
}

const { blocks, components, linkTo } = Astro.props;
const map = components as Record<string, any>;
// In an editor's draft preview, comments mark where each block starts, so the editor can point at one.
const marked = inPreview();
// The picker's background render (never the page on screen) adds each block rendered again with each field changed.
const picking = inPickRender();
const source = picking && blocks ? pickSource(blocks) : null;
function variants(block: AnyBlock) {
  return [
    { path: "@base", block },
    // A second render of the same block: what differs between the two isn't any field's doing.
    { path: "@noise", block },
    ...pickVariants(block).map(variant => ({ path: JSON.stringify(variant.path), block: variant.block }))
  ];
}
---
{(blocks ?? []).map((block, i) => {
  const Component = map[block.type];
  return (
    <>
      {/* The block's key too: unique across every list on the page, so the editor can point at this block even when a page renders several lists. */}
      {marked && <Fragment set:html={`<!--vibe-block:${i}${typeof (block as { _key?: unknown })._key === "string" && /^[\w-]+$/.test((block as { _key: string })._key) ? `:${(block as { _key: string })._key}` : ""}-->`} />}
      {Component ? <Component {...block} /> : <Fragment set:html={renderBlock(block, { linkTo })} />}
      {picking && (
        <template data-vibe-variants={i} data-vibe-type={block.type} data-vibe-source={source ? JSON.stringify(source) : undefined}>
          {variants(block).map(variant => (
            <Variant path={variant.path}>
              {Component ? <Component {...variant.block} /> : <Fragment set:html={renderBlock(variant.block, { linkTo })} />}
            </Variant>
          ))}
        </template>
      )}
    </>
  );
})}
{marked && <Fragment set:html="<!--/vibe-blocks-->" />}
