{
  "name": "vibe-cms-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "examples/*"
  ],
  "scripts": {
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "dev": "bun run --filter @vibe-cms/example-blog dev"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.11",
    "happy-dom": "^21.0.4",
    "oxlint": "^1.90.0",
    "typescript": "^7"
  }
}
