---
// Every path that isn't another route: look up the page with that path and render its blocks.
import { findPage } from "@vibe-cms/blocks";
import { Blocks } from "@vibe-cms/blocks/astro";
import "@vibe-cms/blocks/styles.css";
import Pricing from "../blocks/Pricing.astro";
import Testimonial from "../blocks/Testimonial.astro";
import { FeatureGrid } from "../components/FeatureGrid.tsx";
import { cms, localeFrom, page } from "../content.ts";
import Base from "../layouts/Base.astro";

const entry = await findPage(cms, page, Astro.url.pathname, { locale: localeFrom(Astro.url) });
if(!entry) return new Response("Not found", { status: 404 });
---

<Base title={entry.title} description={entry.description} wide>
  <Blocks
    blocks={entry.blocks}
    components={{
      testimonial: Testimonial,
      features: FeatureGrid,
      pricing: Pricing
    }}
    linkTo={ref => `/${ref.type}s/${ref.id}`}
  />
</Base>
