---
import { renderRichText } from "vibe-cms/rich-text";
import { field } from "vibe-cms/preview";
import { focus, img } from "vibe-cms/media";
import { eq } from "vibe-cms/query";
import Base from "../../layouts/Base.astro";
import { cms, localeFrom, post } from "../../content.ts";

const locale = localeFrom(Astro.url);
const entry = await cms.query(post).findFirst({
  where: eq(post.slug, Astro.params.slug!),
  locale,
  with: { author: true }
});
if(!entry) return new Response("Not found", { status: 404 });
---

<Base title={entry.title} description={entry.seo?.description ?? entry.excerpt}>
  <article class={entry.layout}>
    {entry.cover && (
      <img
        {...img(entry.cover, { sizes: 768, priority: true, field: field(entry, "cover") })}
        style={`object-position: ${focus(entry.cover)}`}
      />
    )}
    <h1 data-vibe-field={field(entry, "title")}>{entry.title}</h1>
    <p><small>{entry.readingMinutes ? `${entry.readingMinutes} min read · ` : ""}<time data-vibe-field={field(entry, "publishedAt")}>{new Date(entry.publishedAt).toLocaleDateString("en", { dateStyle: "long", timeZone: "UTC" })}</time>{entry.author && <> · <span data-vibe-field={field(entry.author, "name")}>{entry.author.name}</span></>}</small></p>
    <Fragment set:html={renderRichText(entry.body, { linkTo: ref => `/${ref.type}s/${ref.id}` })} />
  </article>
  <p><a href="/">← All posts</a></p>
  <script is:inline define:vars={{ id: entry.id }}>
    fetch(`/_vibe/plugins/views/hit/${id}`, { method: "POST" });
  </script>
</Base>
