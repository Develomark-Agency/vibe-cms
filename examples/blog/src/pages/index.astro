---
import { desc } from "vibe-cms/query";
import Base from "../layouts/Base.astro";
import { cms, localeFrom, post } from "../content.ts";

const locale = localeFrom(Astro.url);
const posts = await cms.query(post).findMany({
  orderBy: [desc(post.publishedAt)],
  limit: 20,
  locale,
  with: { author: true }
});
---

<Base>
  {posts.length === 0 && (
    <p>No posts yet. Open the <a href="/_vibe/admin/">editor</a> and publish one.</p>
  )}
  {posts.map(entry => (
    <article>
      <h2><a href={`/posts/${entry.slug}${locale ? `?lang=${locale}` : ""}`}>{entry.title}</a></h2>
      <p>
        <small>{new Date(entry.publishedAt).toLocaleDateString("en", { dateStyle: "long", timeZone: "UTC" })}{entry.author && ` · ${entry.author.name}`}</small>
      </p>
      {entry.excerpt && <p>{entry.excerpt}</p>}
      {entry.tags.map(tag => <span class="tag">{tag}</span>)}
    </article>
  ))}
</Base>
