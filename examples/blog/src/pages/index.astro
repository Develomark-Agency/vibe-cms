---
import { field } from "vibe-cms/preview";
import { desc } from "vibe-cms/query";
import Base from "../layouts/Base.astro";
import { cms, localeFrom, post } from "../content.ts";

const locale = localeFrom(Astro.url);
const posts = await cms.query(post).findMany({
  orderBy: [desc(post.publishedAt)],
  limit: 20,
  locale,
  with: { author: true }
});
---

<Base>
  {posts.length === 0 && (
    <p>No posts yet. Open the <a href="/_vibe/admin/">editor</a> and publish one.</p>
  )}
  {posts.map(entry => (
    <article>
      <h2 data-vibe-field={field(entry, "title")}><a href={`/posts/${entry.slug}${locale ? `?lang=${locale}` : ""}`}>{entry.title}</a></h2>
      <p>
        <small><time data-vibe-field={field(entry, "publishedAt")}>{new Date(entry.publishedAt).toLocaleDateString("en", { dateStyle: "long", timeZone: "UTC" })}</time>{entry.author && <> · <span data-vibe-field={field(entry.author, "name")}>{entry.author.name}</span></>}</small>
      </p>
      {entry.excerpt && <p data-vibe-field={field(entry, "excerpt")}>{entry.excerpt}</p>}
      {entry.tags.map((tag, i) => <span class="tag" data-vibe-field={field(entry, "tags", i)}>{tag}</span>)}
    </article>
  ))}
</Base>
