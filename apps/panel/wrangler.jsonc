{
  // The agency panel. Copy this app, set the variables below, `bun run deploy`.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vibe-panel",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    // The API, sign-in, agent and CLI (OAuth, MCP, site tokens) routes run in the Worker; everything else is the app.
    "run_worker_first": ["/api/*", "/auth/*", "/mcp", "/oauth/*", "/site-token", "/.well-known/*"],
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "vibe-panel", "database_id": "00000000-0000-0000-0000-000000000000" }
  ],
  // The backup archive. Remove it (and the trigger) to run the panel without backups.
  "r2_buckets": [{ "binding": "BACKUPS", "bucket_name": "vibe-panel-backups" }],
  // Runs scheduled backups, retries and interrupted runs.
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    "OIDC_ISSUER": "https://accounts.google.com",
    "OIDC_CLIENT_ID": "1234.apps.googleusercontent.com",
    // Comma-separated email domains or group claim values.
    "PANEL_ALLOW": "my-agency.com",
    // The panel's public address: the hub sites trust with `auth: hub({ url: "https://…" })`.
    "PANEL_URL": "https://panel.my-agency.com"
    // Optional white-labelling: "PANEL_NAME", "PANEL_ACCENT" (#rrggbb, also the accent of framed
    // sites that don't set their own) and "PANEL_ICON" (an image URL).
  }
  // Secret: `wrangler secret put OIDC_CLIENT_SECRET` (locally: .dev.vars).
}
